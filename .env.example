# Copy to .env to change a default. Nothing here is required: Discovery's API
# needs no key and no account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/tna-discovery-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so The National
# Archives can reach you if your use ever causes it trouble.
# TNA_DISCOVERY_CONTACT=you@example.org

# Optional: HTTP timeout in seconds for one request (default 30).
# TNA_DISCOVERY_TIMEOUT=30

# Optional: least seconds between two requests (default 1, never below 1:
# TNA's guideline is no more than one request a second).
# TNA_DISCOVERY_MIN_INTERVAL=1

# Optional: requests a day (UTC) before every tool refuses (default 3000, never
# above it: TNA's guideline). Lower it to leave headroom for other tools.
# TNA_DISCOVERY_DAILY_BUDGET=3000

# Optional: where the day's call count is kept, the one file the server
# writes. It holds a date and a number, never anything the API returned.
# TNA_DISCOVERY_STATE_DIR=~/.local/state/tna-discovery-mcp
